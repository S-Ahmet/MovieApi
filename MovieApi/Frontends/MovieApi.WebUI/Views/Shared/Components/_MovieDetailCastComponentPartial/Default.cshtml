@model List<MovieApi.Dto.Dtos.MovieDtos.ResultCastDto>

<div id="cast" class="tab">
	<div class="row">
		<h3>Oyuncular ve Set Ekibi</h3>

		<!-- Yönetmen & Yazarlar kısmı sabit kalabilir -->
		<div class="title-hd-sm">
			<h4>Yönetmen & Senaryo Yazarları</h4>
		</div>
		<div class="mvcast-item">
			<div class="cast-it">
				<div class="cast-left">
					<h4>JW</h4>
					<a href="#">Joss Whedon</a>
				</div>
				<p>...  Yönetmen</p>
			</div>
		</div>

		<!-- Oyuncular Başlığı -->
		<div class="title-hd-sm mt-4">
			<h4>Oyuncular</h4>
		</div>

		<!-- Dinamik oyuncular -->
		<div class="mvcast-item">
			@foreach (var cast in Model)
			{
				<div class="cast-it">
					<div class="cast-left">
						<img src="@cast.ImageUrl" alt="@cast.Name @cast.Surname" style="width: 70px; height: 90px; object-fit: cover;" />
						<a href="#">@cast.Name @cast.Surname</a>
					</div>
					<p>... @cast.Name @cast.Surname</p>
				</div>
			}
		</div>

		<!-- Yapımcılar (istersen sabit tutabilirsin) -->
		<div class="title-hd-sm mt-4">
			<h4>Yapımcılar</h4>
		</div>
		<div class="mvcast-item">
			<div class="cast-it">
				<div class="cast-left">
					<h4>KF</h4>
					<a href="#">Kevin Feige</a>
				</div>
				<p>... Yapımcı</p>
			</div>
		</div>
	</div>
</div>
