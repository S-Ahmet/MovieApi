@model MovieApi.Dto.Dtos.ReviewDtos.CreateReviewDto

@{
    ViewData["Title"] = "Filme Yorum Yap";
    Layout = "~/Views/UserWebUILayout/LayoutUI.cshtml";
}

<style>
    body {
        background-color: #0d1b2a !important;
    }

    .review-card {
        background-color: rgba(13, 27, 42, 0.85);
        border-radius: 20px;
        padding: 30px;
        color: #ffffff;
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
    }

        .review-card label {
            color: #ffffff;
            font-weight: bold;
        }

        .review-card input,
        .review-card textarea {
            background-color: #1c2b3a;
            color: white;
            border: 1px solid #3b4b5c;
        }

            .review-card input::placeholder,
            .review-card textarea::placeholder {
                color: #cccccc;
            }

        .review-card .btn-primary {
            background-color: #DD003F;
            border-color: #DD003F;
        }

            .review-card .btn-primary:hover {
                background-color: #DD003F;
            }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="review-card">
                <h2 class="text-center mb-4">Filme Yorum Yap</h2>
                <form method="post" asp-action="AddReview" asp-controller="Movie">
                    <input type="hidden" name="MovieId" value="@Model.MovieId" />

                    <div class="mb-3">
                        <label class="form-label">Ad Soyad</label>
                        <input type="text" class="form-control" name="ReviewerName" placeholder="Adınızı girin" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Yorumunuz</label>
                        <textarea class="form-control" name="ReviewComment" rows="4" placeholder="Yorumunuzu buraya yazın..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Puan (1-5)</label>
                        <input type="number" class="form-control" name="UserRating" min="1" max="5" placeholder="1 ile 5 arasında bir puan" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a class="btn btn-secondary" asp-action="MovieDetail" asp-route-id="@Model.MovieId">Geri Dön</a>
                        <button type="submit" class="btn btn-primary">Yorumu Gönder</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
